# Supabase — required for admin login and book storage (Vite inlines these at build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — run `npm run setup:admin` once locally (never expose in browser / never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
