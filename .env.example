# Supabase — required (set these in Netlify → Site settings → Environment variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service role — backend ONLY, never VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Netlify deploy: add VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in the Netlify dashboard.
# SPA routing is handled by netlify.toml and public/_redirects.
